<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- Nur für die Entwicklungs-Weiterleitung (TCP im Tailnet, host/esp_tcp_bridge.py). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Vordergrunddienst Typ connectedDevice; CHANGE_NETWORK_STATE ist eine der dafür nötigen Voraussetzungen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lesen bei ausgeschaltetem Bildschirm (Aufnahme), nur solange verbunden. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- EKG-Gurt als Pulsreferenz (V0.1): BLE-Suche ohne Standort, Verbinden. -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".RadarApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.RadarSensor">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <service
            android:name=".core.RadarService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
